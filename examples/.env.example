# Szablon zmiennych środowiskowych dla przykładów qa-tools.
# Skopiuj do .env (NIGDY nie commituj .env) i uzupełnij wartościami środowiska testowego.

# Adres aplikacji webowej (Playwright baseURL)
BASE_URL=http://localhost:3000

# Token API dla testów api/ i security/ (Bearer)
API_TOKEN=

# Hasło konta testowego dla testów UI (logowanie)
TEST_USER_PASSWORD=

# Ścieżka/URL do specyfikacji OpenAPI (testy kontraktowe)
OPENAPI_SPEC=
