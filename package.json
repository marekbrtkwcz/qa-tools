{
  "name": "qa-tools",
  "version": "0.6.0",
  "private": true,
  "description": "Native Mistral Vibe CLI plugins for test automation: skills, subagents, knowledge and quality-gate hooks (Agent Plugins 1.0 format).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marekbrtkwcz/qa-tools.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/build.js --check && node scripts/lint-all-packs.js && node scripts/check-changelog.js && node scripts/check-bundles-duplicates.js",
    "verify": "node scripts/build.js --verify",
    "validate-manifests": "node scripts/validate-manifests.js",
    "lint": "biome check scripts && node scripts/lint-all-packs.js",
    "test": "node --test scripts/build.test.js scripts/assets/test-file-guard.test.js scripts/assets/red-test-deletion-guard.test.js",
    "ci": "npm run check && npm run validate-manifests && npm run lint && npm run verify && npm test",
    "changelog": "node scripts/generate-changelog.js",
    "changelog:check": "node scripts/generate-changelog.js --dry-run",
    "readme:stats": "node scripts/update-readme-stats.js",
    "readme:stats:check": "node scripts/update-readme-stats.js --check",
    "links": "node scripts/validate-links.js",
    "links:check": "node scripts/validate-links.js --check",
    "p2": "npm run changelog:check && npm run readme:stats:check && npm run links:check",
    "p2:all": "npm run changelog && npm run readme:stats && npm run links",
    "test:p3": "node --test scripts/validate-links.test.js scripts/generate-changelog.test.js scripts/update-readme-stats.test.js",
    "test:all": "npm test && npm run test:p3",
    "p4": "npm run security:scan && npm run flaky:check && npm run benchmark",
    "security:scan": "node scripts/security-scan.js",
    "flaky:check": "node scripts/detect-flaky-tests.js --runs 3 --check",
    "flaky:detect": "node scripts/detect-flaky-tests.js --runs 5",
    "benchmark": "node scripts/benchmark-performance.js --runs 3",
    "benchmark:full": "node scripts/benchmark-performance.js --runs 5 --save",
    "test:p4": "node --test scripts/security-scan.test.js scripts/detect-flaky-tests.test.js scripts/benchmark-performance.test.js",
    "test:all:p4": "npm run test:all && npm run test:p4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@vitest/coverage-v8": "^5.1.1",
    "conventional-changelog": "^6.0.0",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1",
    "yaml": "^2.6.0"
  }
}
