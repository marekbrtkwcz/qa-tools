{
  "name": "qa-tools",
  "version": "0.6.0",
  "private": true,
  "description": "Native Mistral Vibe CLI plugins for test automation: skills, subagents, knowledge and quality-gate hooks (Agent Plugins 1.0 format).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marekbrtkwcz/qa-tools.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/build.ts --check && node scripts/lint-all-packs.ts && node scripts/check-changelog.ts && node scripts/check-bundles-duplicates.ts",
    "verify": "node scripts/build.ts --verify",
    "validate-manifests": "node scripts/validate-manifests.ts",
    "lint": "biome check scripts && node scripts/lint-all-packs.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/build.test.ts scripts/assets/test-file-guard.test.js scripts/assets/red-test-deletion-guard.test.js",
    "ci": "npm run check && npm run validate-manifests && npm run lint && npm run verify && npm test",
    "changelog": "node scripts/generate-changelog.ts",
    "changelog:check": "node scripts/generate-changelog.ts --dry-run",
    "readme:stats": "node scripts/update-readme-stats.ts",
    "readme:stats:check": "node scripts/update-readme-stats.ts --check",
    "links": "node scripts/validate-links.ts",
    "links:check": "node scripts/validate-links.ts --check",
    "p2": "npm run changelog:check && npm run readme:stats:check && npm run links:check",
    "p2:all": "npm run changelog && npm run readme:stats && npm run links",
    "test:p3": "node --test scripts/validate-links.test.ts scripts/generate-changelog.test.ts scripts/update-readme-stats.test.ts",
    "test:all": "npm test && npm run test:p3",
    "p4": "npm run security:scan && npm run flaky:check && npm run benchmark",
    "security:scan": "node scripts/security-scan.ts",
    "flaky:check": "node scripts/detect-flaky-tests.ts --runs 3 --check",
    "flaky:detect": "node scripts/detect-flaky-tests.ts --runs 5",
    "benchmark": "node scripts/benchmark-performance.ts --runs 3",
    "benchmark:full": "node scripts/benchmark-performance.ts --runs 5 --save",
    "test:p4": "node --test scripts/security-scan.test.ts scripts/detect-flaky-tests.test.ts scripts/benchmark-performance.test.ts",
    "test:all:p4": "npm run test:all && npm run test:p4",
    "p5": "npm run quarantine:detect && npm run security:enforce && npm run perf:check",
    "quarantine:detect": "node scripts/quarantine-flaky-tests.ts detect --force",
    "quarantine:list": "node scripts/quarantine-flaky-tests.ts list",
    "quarantine:add": "node scripts/quarantine-flaky-tests.ts add",
    "quarantine:remove": "node scripts/quarantine-flaky-tests.ts remove",
    "quarantine:clear": "node scripts/quarantine-flaky-tests.ts clear",
    "quarantine:restore": "node scripts/quarantine-flaky-tests.ts restore",
    "security:enforce": "node scripts/security-gate-enforce.ts check",
    "security:validate": "node scripts/security-gate-enforce.ts validate",
    "perf:baseline": "node scripts/performance-regression-alerts.ts baseline",
    "perf:check": "node scripts/performance-regression-alerts.ts check",
    "perf:alert": "node scripts/performance-regression-alerts.ts alert",
    "perf:history": "node scripts/performance-regression-alerts.ts history",
    "perf:clear": "node scripts/performance-regression-alerts.ts clear",
    "test:p5": "node --test scripts/assets/quality-gate-hook.test.js scripts/quarantine-flaky-tests.test.ts scripts/performance-regression-alerts.test.ts scripts/security-gate-enforce.test.ts",
    "test:all:p5": "npm run test:all:p4 && npm run test:p5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.1",
    "conventional-changelog": "^6.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.6.0"
  }
}
