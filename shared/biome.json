{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "organizeImports": { "enabled": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnsafeAbstractClassInstantiation": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noSuspiciousComment": "warn"
      },
      "style": {
        "useConst": "warn",
        "useNestedTernary": "warn"
      }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "files": {
    "include": ["src/**/*", "tests/**/*", "scripts/**/*", "*.config.ts", "biome.json"],
    "ignore": ["node_modules/**", "dist/**", "coverage/**", "playwright-report/**", "test-results/**"]
  }
}
