# Szablon zmiennych środowiskowych — skopiuj do katalogu głównego projektu jako .env.example
# (.env jest gitignored; .env.example zostaje w repo). W projekcie używamy biblioteki dotenv.

# Aplikacja / API
BASE_URL=http://localhost:3000
API_URL=http://localhost:8080/api
OPENAPI_SPEC=docs/openapi/openapi.json
LOGGER=false

# Testowe konta (TYLKO środowisko testowe — nigdy prawdziwe dane)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Baza danych (skrypty SQL, uruchamiane przez dotenv-cli)
DATABASE_URL=

# k6 (testy wydajnościowe, __ENV w skryptach)
K6_TARGET_URL=
